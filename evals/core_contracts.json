  {
    "id": "correction-preserves-unrelated-fact",
    "events": [
      {"id": "e1", "kind": "user", "text": "The docs site is hosted on Netlify."},
      {"id": "e2", "kind": "user", "text": "For this project, run mock tests before integration tests."},
      {"id": "e3", "kind": "user", "text": "Correction: run integration tests first; mocks missed the callback failure."}
    ],
    "queries": [
      {"id": "q1", "text": "How should callbacks be tested?"},
      {"id": "q2", "text": "Where is the docs site hosted?"}
    ],
    "expect": {
      "recall": {"q1": ["test-preference"], "q2": ["docs-host"]},
      "records": {
        "test-preference-old": {"type": "semantic", "state": "superseded", "sources": ["e2"]},
        "test-preference": {"type": "semantic", "state": "active", "sources": ["e3"]},
        "docs-host": {"type": "semantic", "state": "active", "sources": ["e1"]}
      },
      "memory_count": 3
    }
  },
  {
    "id": "compatible-versus-contradictory",
    "events": [
