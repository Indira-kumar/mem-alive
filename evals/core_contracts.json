        "primary-db-old": {"type": "semantic", "state": "superseded", "sources": ["e1"]},
        "primary-db-new": {"type": "semantic", "state": "active", "sources": ["e3"]}
      },
      "inspectable": ["primary-db-old"],
      "memory_count": 3
    }
  },
  {
