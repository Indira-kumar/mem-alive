      "records": {
        "user-practice": {"type": "semantic", "state": "active", "sources": ["e1"]},
        "project-a-exception": {"type": "semantic", "state": "active", "sources": ["e2"]}
      },
      "memory_count": 2
    }
  },
  {
    "id": "procedure-needs-independent-verification",
    "events": [
      {"id": "e1", "kind": "agent", "text": "I think restarting the worker fixed the queue."},
      {"id": "e2", "kind": "tool_result", "text": "First queue recovery check passed after restart.", "attempt": "a1"},
      {"id": "e3", "kind": "tool_result", "text": "A separate queue recovery check passed after restart.", "attempt": "a2"},
      {"id": "e4", "kind": "tool_result", "text": "A later restart failed to recover a queue with a full disk.", "attempt": "a3"}
    ],
    "queries": [{"id": "q1", "text": "How do I recover a stalled queue?"}],
    "expect_after": {
      "e1": {"recall": {"q1": []}},
      "e2": {
        "records": {"restart-conditional": {"type": "procedural", "state": "candidate", "sources": ["e2"]}},
        "memory_count": 1
      },
      "e3": {
        "records": {"restart-conditional": {"type": "procedural", "state": "established", "sources": ["e2", "e3"]}},
        "memory_count": 1
      }
    },
    "expect": {
      "recall": {"q1": ["restart-conditional"]},
      "records": {
        "restart-conditional": {
          "type": "procedural", "state": "established", "sources": ["e2", "e3", "e4"]
        }
      },
      "memory_count": 1
    }
  },
  {
    "id": "episode-keeps-event-and-outcome",
    "events": [
